# Required: Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-1234567890

# Optional: Pushover Application API token for mobile push alerts
PUSHOVER_APP_TOKEN=your_pushover_app_token_here

# Optional: Redis connection URL (falls back gracefully via 30s circuit breaker if unavailable)
REDIS_URL=redis://localhost:6379/0

# Optional: SQLite SQLAlchemy URL (defaults to ./bot_database.db)
# DATABASE_URL=sqlite:///bot_database.db